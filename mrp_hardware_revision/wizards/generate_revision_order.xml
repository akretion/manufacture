<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_run_mrp_multi_level_wizard" model="ir.ui.view">
        <field name="model">generate.revision.order</field>
        <field name="arch" type="xml">
            <form string="Generate Hardware revision Order">
                <group>
                    <field name="name" />
                    <field name="planned_start_date" />
                    <field name="planned_end_date" />
                    <field name="bump_revision" />
                </group>
                <footer>
                    <button
                        name="generate_order"
                        string="Confirm"
                        type="object"
                        class="oe_highlight"
                    />
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_generate_revision_order" model="ir.actions.act_window">
        <field name="name">Generate Hardware revision Order</field>
        <field name="res_model">generate.revision.order</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_product_hardware_revision" />
    </record>
</odoo>
