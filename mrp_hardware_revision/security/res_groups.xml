<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- This group is meant to manage PLM stages -->
    <record
        model="ir.module.category"
        id="module_category_hardware_revision_management"
    >
        <field name="name">Hardware Revision</field>
        <field name="description">Helps you manage your hardware revisons</field>
        <field name="sequence">5</field>
    </record>

    <record id="hardware_revision_manager_group" model="res.groups">
        <field name="name">Administrator</field>
        <field
            name="category_id"
            ref="mrp_hardware_revision.module_category_hardware_revision_management"
        />
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]" />
        <field
            name="comment"
        >The Hardware Revision administrator manage the plan and hardware revision, ECO...</field>
        <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>
</odoo>
