<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="hardware_revision_order_form_view">
        <field name="name">hardware.revision.order.form</field>
        <field name="model">hardware.revision.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_confirm"
                        type="object"
                        invisible="state != 'draft'"
                        string="Confirm"
                    />
                    <button
                        name="action_done"
                        type="object"
                        invisible="state != 'ongoing'"
                        string="Validate"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,ongoing,done"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            type="object"
                            name="action_view_new_revision"
                            class="oe_stat_button"
                            icon="fa-cogs"
                            invisible="not new_hardware_revision_id"
                        >Revision
                    </button>
                    </div>
                    <h1>
                        <label string="Reference" for="name" />
                        <field
                            name="name"
                            class="oe_inline"
                            readonly="state != 'draft'"
                        />
                    </h1>
                    <group>
                        <group>
                            <field name="hardware_revision_id" />
                            <field name="bump_revision" />
                        </group>
                        <group>
                            <field name="start_date" readonly="state != 'draft'" />
                            <field name="end_date" readonly="state != 'draft'" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record model="ir.ui.view" id="hardware_revision_order_list_view">
        <field name="model">hardware.revision.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="hardware_revision_id" />
                <field name="start_date" />
                <field name="end_date" />
                <field name="state" />
            </list>
        </field>
    </record>
    <record model="ir.actions.act_window" id="action_hardware_revision_order">
        <field name="name">Hardware Revision Orders</field>
        <field name="res_model">hardware.revision.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        name="Hardware Revision Orders"
        parent="hardware_revision_menu"
        id="hardware_revision_order_menu"
        action="action_hardware_revision_order"
        sequence="10"
    />
</odoo>
