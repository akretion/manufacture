<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="mrp_production_form_view">
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='bom_div']" position="after">
                <field
                    name="hardware_revision_id"
                    readonly="state not in ('draft', 'confirmed', 'progress')"
                    domain="hardware_revision_domain"
                />
                <field
                    name="force_revision"
                    readonly="state not in ('draft', 'confirmed', 'progress')"
                    groups="mrp_hardware_revision.group_hardware_revision_force_version"
                />
            </xpath>
            <field name="lot_producing_id" position="attributes">
                <attribute
                    name="context"
                >{'default_product_id': product_id, 'default_hardware_revision_id': hardware_revision_id}</attribute>
            </field>
            <button name="action_generate_serial" position="attributes">
                <attribute
                    name="context"
                >{'default_hardware_revision_id': hardware_revision_id}</attribute>
            </button>
        </field>
    </record>
</odoo>
