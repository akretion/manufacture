<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="purchase_order_form">
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath expr="/form/sheet" position="before">
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="not ongoing_eco_message"
                >
                    <field name="ongoing_eco_message" />
                </div>
            </xpath>
            <xpath
                expr="//field[@name='order_line']//list/field[@name='date_planned']"
                position="before"
            >
                <field name="hardware_revision_id" options="{'no_create': True}" />
                <field name="prototype" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>
