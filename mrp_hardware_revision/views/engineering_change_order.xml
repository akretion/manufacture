<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="engineering_change_order_form_view">
        <field name="name">engineering.change.order.form</field>
        <field name="model">engineering.change.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_confirm"
                        type="object"
                        invisible="state != '1-draft'"
                        string="Confirm"
                    />
                    <button
                        name="action_draft"
                        type="object"
                        invisible="state in ('1-draft', '4-done')"
                        string="Back to draft"
                        confirm="The ongoing changes will be deleted, you will have to do it again in case of re-validation of the ECO later."
                    />
                    <!--<button
                        name="validate_prototype"
                        type="object"
                        invisible="state != '2-ongoing'"
                        string="Validate Prototype"
                    />-->
                    <button
                        name="action_done"
                        type="object"
                        invisible="state != '2-ongoing'"
                        string="Validate"
                        confirm="This validation is definitive. The changes on hardware revisions or BOMs will be pusblished."
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="1-draft,2-ongoing,3-prototype,4-done"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            type="object"
                            name="action_view_new_revision"
                            class="oe_stat_button"
                            icon="fa-cogs"
                            invisible="not new_hardware_revision_ids"
                        >Revisions
                        <button
                            type="object"
                            name="action_view_new_boms"
                            class="oe_stat_button"
                            icon="fa-flask"
                            invisible="new_bom_count == 0"
                        >
                            <field
                                name="new_bom_count"
                                widget="statinfo"
                                string="New BOMs"
                            />
                        </button>
                    </button>
                    </div>
                    <h1>
                        <!--                        <label string="Reference" for="name" />-->
                        <field name="name" class="oe_inline" readonly="1" />
                    </h1>
                    <group>
                        <group>
                            <field name="description" />
                            <field
                                name="product_id"
                                invisible="state != '1-draft'"
                                readonly="state != '1-draft'"
                                domain="[('plan_id', '!=', False)]"
                                options="{'no_create': True, 'no_open': True}"
                            />
                            <field
                                name="plan_ids"
                                widget="many2many_tags"
                                required="1"
                                readonly="state != '1-draft'"
                            />
                            <field name="bom_update" />
                        </group>
                        <group>
                            <field name="start_date" readonly="state != '1-draft'" />
                            <field name="end_date" readonly="state != '1-draft'" />
                            <field
                                name="declaration_number"
                                readonly="state not in ('1-draft', '2-ongoing')"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="product_ids">
                                <list>
                                    <field name="default_code" />
                                    <field name="name" />
                                    <field name="plan_id_name" string="Plan" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="engineering_change_order_kanban" model="ir.ui.view">
        <field name="name">engineering.change.order.kanban</field>
        <field name="model">engineering.change.order</field>
        <field name="arch" type="xml">
            <kanban
                default_group_by="state"
                class="o_kanban_small_column"
                quick_create="false"
                sample="1"
            >
                <field name="state" readonly="1" />
                <templates>
                    <t t-name="card">
                        <field name="name" class="fs-5 fw-bolder" />
                        <field name="plan_ids" widget="many2many_tags" />
                        <!--                        <div class="text-muted">
                            <t
                                t-if="record.planned_end_date.raw_value and record.planned_end_date.raw_value lt (new Date())"
                                t-set="red"
                            >text-danger</t>
                            <span t-attf-class="#{red || ''}">
                                <field name="planned_end_date" class="fst-italic" />
                            </span>
                        </div>-->
                        <footer class="pt-0">
                            <div class="d-flex align-items-center ms-auto">
                                <field
                                    name="activity_ids"
                                    widget="kanban_activity"
                                    groups="base.group_user"
                                />
                            </div>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record model="ir.ui.view" id="engineering_change_order_list_view">
        <field name="model">engineering.change.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="start_date" />
                <field name="end_date" />
                <field name="state" />
            </list>
        </field>
    </record>
    <record model="ir.actions.act_window" id="action_engineering_change_order">
        <field name="name">Engineering Change Orders</field>
        <field name="res_model">engineering.change.order</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem
        name="Engineering Change Orders"
        parent="hardware_revision_menu"
        id="engineering_change_order_menu"
        action="action_engineering_change_order"
        sequence="20"
    />
</odoo>
