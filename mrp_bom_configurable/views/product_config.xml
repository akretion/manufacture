<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_config_form_window" model="ir.ui.view">
        <field name="name">product.config.form.window</field>
        <field name="model">product.config</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <field name="name" class="oe_inline" placeholder="Name" />
                    </h1>
                    <group name="main" />
                </sheet>
            </form>
        </field>
    </record>

    <record id='product_config_tree' model='ir.ui.view'>
        <field name='model'>product.config</field>
        <field name='arch' type='xml'>
            <list multi_edit="1" class="product_config_tree">
                <button
                    name="open_form_pop_up"
                    class="fa fa-eye"
                    type="object"
                    title="Info"
                />
                <field name="name" />
                <field name="alert" optional="show" />
                <field name="constraint_suggestions" optional="show" />
                <field name="satisfies_constraint" optional="hide" />
            </list>
        </field>
    </record>

    <record id="product_config_search" model="ir.ui.view">
        <field name="model">product.config</field>
        <field name="arch" type="xml">
            <search>
                <filter name="name" />
                <filter
                    name="bom_id"
                    string="Bom"
                    domain="[]"
                    context="{'group_by' : 'bom_id'}"
                />
            </search>
        </field>
    </record>

    <menuitem id="configurator_menu" name="Configurator" parent="mrp.menu_mrp_root" />

    <menuitem
        id="product_configuration_menu"
        parent="configurator_menu"
        name="Configurations"
        sequence="10"
    />
</odoo>
