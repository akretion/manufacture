<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="dmr_form_view">
        <field name="name">dmr.form</field>
        <field name="model">dmr</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <field name="name" />
                    </h1>
                    <separator string="Products" />
                    <field name="product_ids" />
                    <separator string="Linked Products" />
                    <field name="linked_product_ids" />
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="dmr_list_view">
        <field name="model">dmr</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_dmr">
        <field name="name">DMR</field>
        <field name="res_model">dmr</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        name="DMR"
        parent="mrp_hardware_revision.hardware_revision_menu"
        id="dmr_menu"
        action="action_dmr"
        sequence="5"
    />
</odoo>
