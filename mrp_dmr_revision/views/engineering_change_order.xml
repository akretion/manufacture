<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="engineering_change_order_form_view">
        <field name="model">engineering.change.order</field>
        <field
            name="inherit_id"
            ref="mrp_hardware_revision.engineering_change_order_form_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    type="object"
                    name="action_view_new_dmr_revision"
                    class="oe_stat_button"
                    icon="fa-cogs"
                    invisible="not new_dmr_revision_ids"
                >DMR Revisions</button>
            </xpath>
            <field name="description" position="after">
                <field
                    name="dmr_ids"
                    widget="many2many_tags"
                    required="1"
                    readonly="state != '1-draft'"
                />
            </field>
            <field name="plan_ids" position="attributes">
                <attribute name="required">0</attribute>
            </field>
        </field>
    </record>
</odoo>
