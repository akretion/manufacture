<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="manufacturing_routing_form_view">
        <field name="name">manufacturing.routing.form</field>
        <field name="model">manufacturing.routing</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <field name="name" />
                    </h1>
                    <separator string="Products" />
                    <field name="product_ids" />
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="manufacturing_routing_list_view">
        <field name="model">manufacturing.routing</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_manufacturing_routing">
        <field name="name">Manufacturing Routing</field>
        <field name="res_model">manufacturing.routing</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        name="Manufacturing Routing"
        parent="hardware_revision_menu"
        id="manufacturing_routing_menu"
        action="action_manufacturing_routing"
        sequence="5"
    />
</odoo>
