<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="engineering_change_order_form_view">
        <field name="model">engineering.change.order</field>
        <field
            name="inherit_id"
            ref="mrp_hardware_revision.engineering_change_order_form_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    type="object"
                    name="action_view_new_manufacturing_routing_revision"
                    class="oe_stat_button"
                    icon="fa-cogs"
                    invisible="not new_manufacturing_routing_revision_ids"
                >Manufacturing Routing Revision</button>
            </xpath>
            <field name="description" position="after">
                <field name="manufacturing_routing_id" />
            </field>
        </field>
    </record>
</odoo>
