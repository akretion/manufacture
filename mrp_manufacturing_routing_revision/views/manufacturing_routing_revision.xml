<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="manufacturing_routing_revision_form_view">
        <field name="name">manufacturing.routing.revision.form</field>
        <field name="model">manufacturing.routing.revision</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!--
                    <button
                        name="action_draft"
                        type="object"
                        invisible="state != 'canceled'"
                        string="Draft"
                    />-->
                </header>
                <sheet>
                    <label string="Plan" for="plan_id" />
                    <field name="plan_id" class="oe_inline" />
                    <h1>
                        <label string="Revision " for="name" />
                        <field name="name" class="oe_inline" />
                    </h1>
                    <group>
                        <group>
                            <!--
                            <field name="product_id" />
                            <field name="bom_ids" invisible="1" />
                            -->
                            <field name="start_date" />
                            <field name="prototype" />
                        </group>
                        <group />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record model="ir.ui.view" id="manufacturing_routing_revision_list_view">
        <field name="name">manufacturing.routing.revision.list</field>
        <field name="model">manufacturing.routing.revision</field>
        <field name="arch" type="xml">
            <list>
                <header />
                <field name="manufacturing_routing_id" />
                <field name="name" />
                <!--
                <field name="product_id" />
                -->
                <field name="start_date" />
                <field name="prototype" />
                <field name="is_current_revision" />
            </list>
        </field>
    </record>
    <record model="ir.ui.view" id="manufacturing_routing_revision_search_view">
        <field name="name">manufacturing.routing.revision.search</field>
        <field name="model">manufacturing.routing.revision</field>
        <field name="arch" type="xml">
            <search string="Search Revision">
                <group>
                    <field name="manufacturing_order_id" />
                    <field name="name" />
                    <!--
                    <field name="product_id" />
                    -->
                </group>
                <newline />
                <filter
                    string="Current Revision"
                    name="current_revision"
                    domain="[('is_current_revision', '=', True)]"
                />
                <newline />
                <filter
                    string="Prototype"
                    name="prototype"
                    domain="[('prototype', '=', True)]"
                />
                <newline />
                <group expand="0" string="Group by...">
                    <!--
                    <filter
                        string="Product"
                        name="group_by_product_id"
                        domain="[]"
                        context="{'group_by': 'product_id'}"
                    />-->
                </group>
            </search>
        </field>
    </record>
    <record model="ir.actions.act_window" id="action_manufacturing_routing_revision">
        <field name="name">Manufacturing Routing Revision</field>
        <field name="res_model">manufacturing.routing.revision</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        name="Manufacturing Routing Revision"
        parent="hardware_revision_menu"
        id="manufacturing_routing_revision_menu"
        action="action_manufacturing_routing_revision"
        sequence="10"
    />
</odoo>
